# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Obligatorio en producción. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROOMCAM_JWT_SECRET=

# Dirección pública del servidor (https en producción).
ROOMCAM_PUBLIC_URL=http://localhost:8000
ROOMCAM_DB_PATH=roomcam.db

# Web Push. Genera las claves con: python -m roomcam_server.keys
ROOMCAM_VAPID_PUBLIC_KEY=
ROOMCAM_VAPID_PRIVATE_KEY=
ROOMCAM_VAPID_SUBJECT=mailto:tu-correo@example.com

# STUN/TURN. Sin TURN, la vista en vivo puede fallar en algunas redes móviles.
ROOMCAM_STUN_URLS=stun:stun.l.google.com:19302
ROOMCAM_TURN_URLS=
ROOMCAM_TURN_SECRET=
# O, si tu proveedor TURN da usuario y contraseña fijos (en vez de un secreto compartido):
ROOMCAM_TURN_USERNAME=
ROOMCAM_TURN_CREDENTIAL=

# Opcionales (valores por defecto)
# ROOMCAM_ACCESS_MINUTES=15
# ROOMCAM_REFRESH_DAYS=30
# ROOMCAM_PAIRING_MINUTES=5
# ROOMCAM_EVENT_RETENTION_DAYS=30
# ROOMCAM_MIN_PUSH_SECONDS=10
